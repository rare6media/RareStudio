/* RareStudio theme: dark, soft, violet/pink accent. Palette is set in main.cpp; this refines widgets.
   Colours: base #111117 · panel #17171f · raised #1f1f2a · line #2a2a37 · text #ececf4 · muted #9a9ab0
   accent #8b5cf6 -> #ec4899 */

* { outline: none; }
QMainWindow, QDialog { background: #111117; }
QMainWindow::separator { background: #111117; width: 6px; height: 6px; }
QMainWindow::separator:hover { background: #3b2a66; }
QWidget { color: #ececf4; }
QLabel#hint { color: #9a9ab0; }
QLabel#dialogTitle { font-size: 18px; font-weight: 600; }
QLabel#empty { color: #6f6f86; padding: 14px 8px; }
QLabel#warning { color: #fbbf24; }
QLabel#error { color: #f87171; }

/* ---- Toolbar ---------------------------------------------------------------------------- */
QToolBar { background: #15151d; border: none; border-bottom: 1px solid #23232e; padding: 8px 12px; spacing: 10px; }
QToolBar::separator { background: #2a2a37; width: 1px; margin: 8px 6px; }
QToolBar QToolButton { background: transparent; color: #ececf4; border: 1px solid transparent; border-radius: 8px; padding: 6px 12px; font-weight: 600; }
QToolBar QToolButton:hover { background: #22222d; border-color: #2f2f3d; }
QToolBar QToolButton:pressed { background: #2c2140; }
QLabel#stats { color: #8a8aa0; padding: 0 8px; font-size: 12px; }

/* Capsules: a few related controls in one rounded tray. */
QFrame#barGroup, QFrame#statsGroup { background: #1a1a24; border: 1px solid #272734; border-radius: 12px; }
QFrame#barGroup QLabel, QFrame#statsGroup QLabel { background: transparent; border: none; }
QLabel#barCaption { color: #8a7bc8; font-size: 15px; font-weight: 700; padding: 0 2px 0 8px; }

QFrame#barGroup QToolButton#barBtn { background: transparent; border: 1px solid transparent; border-radius: 9px; padding: 6px 13px; color: #d8d8e6; font-weight: 600; }
QFrame#barGroup QToolButton#barBtn:hover { background: #26263a; border-color: #3a3a52; color: #ffffff; }
QFrame#barGroup QToolButton#barBtn:pressed { background: #33255a; }

QFrame#barGroup QComboBox#barCombo, QFrame#barGroup QSpinBox#barSpin { background: #121219; border: 1px solid #2a2a37; border-radius: 9px; padding: 4px 8px; min-height: 20px; }
QFrame#barGroup QComboBox#barCombo:hover, QFrame#barGroup QSpinBox#barSpin:hover { border-color: #4a3a85; }

/* Capture cluster: Rec / pause / replay / clip */
QFrame#barGroup QPushButton#recBtn, QFrame#barGroup QPushButton#capBtn { background: transparent; border: 1px solid transparent; border-radius: 9px; padding: 6px 13px; color: #d8d8e6; font-weight: 600; min-height: 20px; }
QFrame#barGroup QPushButton#recBtn { color: #fca5a5; }
QFrame#barGroup QPushButton#recBtn:hover, QFrame#barGroup QPushButton#capBtn:hover { background: #26263a; border-color: #3a3a52; color: #ffffff; }
QFrame#barGroup QPushButton#recBtn:checked { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #dc2626, stop:1 #e11d48); border-color: #f43f5e; color: white; }
QFrame#barGroup QPushButton#capBtn:checked { background: #33255a; border-color: #8b5cf6; color: #f5f3ff; }
QFrame#barGroup QPushButton#capBtn:disabled { color: #5c5c70; background: transparent; border-color: transparent; }

/* Studio Mode: a pill that lights up violet */
QPushButton#barToggle { background: #1a1a24; border: 1px solid #272734; border-radius: 12px; padding: 8px 16px; font-weight: 600; color: #b9b9cc; min-height: 20px; }
QPushButton#barToggle:hover { border-color: #6d4fd1; color: #ffffff; }
QPushButton#barToggle:checked { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #4c1d95, stop:1 #7c3aed); border-color: #a78bfa; color: white; }

#liveChip, #recChip { border-radius: 13px; font-weight: 700; }
#liveChip { background: rgba(255, 77, 109, 0.14); border: 1px solid rgba(255, 77, 109, 0.45); }
#liveChip QLabel { color: #ff8fa3; }
#recChip { background: rgba(248, 113, 113, 0.10); border: 1px solid rgba(248, 113, 113, 0.35); }
#recChip QLabel { color: #fca5a5; }

QPushButton#goLive {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #7c3aed, stop:1 #ec4899);
    color: white; font-weight: 700; border: none; border-radius: 12px; padding: 10px 26px;
}
QPushButton#goLive:hover { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #8b4cf5, stop:1 #f25aa9); }
QPushButton#goLive:pressed { background: #6d28d9; }
QPushButton#goLive[live="true"] { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #dc2626, stop:1 #e11d48); }
QPushButton#goLive[live="true"]:hover { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ef4444, stop:1 #f43f5e); }

/* ---- Docks & tabs ----------------------------------------------------------------------- */
QDockWidget { color: #b9b9cc; font-weight: 700; titlebar-close-icon: none; }
QDockWidget::title { background: #15151d; padding: 8px 12px; border-bottom: 1px solid #23232e; text-align: left; }
QDockWidget > QWidget { background: #17171f; }

QTabBar { qproperty-drawBase: 0; }
QTabBar::tab { background: transparent; color: #8a8aa0; padding: 7px 14px; margin-right: 2px; border: none; border-bottom: 2px solid transparent; font-weight: 600; }
QTabBar::tab:hover { color: #d4d4e4; }
QTabBar::tab:selected { color: #ececf4; border-bottom: 2px solid #a78bfa; }
QTabWidget::pane { background: #17171f; border: 1px solid #2a2a37; border-radius: 10px; top: -1px; }

QSplitter::handle { background: transparent; }
QSplitter::handle:hover { background: #2c2140; }

/* ---- Buttons ---------------------------------------------------------------------------- */
QPushButton { background: #1f1f2a; color: #ececf4; border: 1px solid #2f2f3d; border-radius: 8px; padding: 6px 14px; min-height: 18px; }
QPushButton:hover { background: #272735; border-color: #7c3aed; }
QPushButton:pressed { background: #33255a; }
QPushButton:checked { background: #33255a; border-color: #8b5cf6; color: #f5f3ff; }
QPushButton:disabled { color: #5c5c70; border-color: #24242f; background: #1a1a22; }
QPushButton[compact="true"] { padding: 4px 0; }
QPushButton#accent { background: #2b1f4a; border-color: #6d4fd1; color: #ede9fe; font-weight: 600; }
QPushButton#accent:hover { background: #36275e; border-color: #a78bfa; }

QToolButton#dockTool { background: #1f1f2a; color: #d8d8e6; border: 1px solid #2f2f3d; border-radius: 7px; padding: 4px 9px; min-width: 14px; font-weight: 600; }
QToolButton#dockTool:hover { background: #272735; border-color: #7c3aed; color: #ffffff; }
QToolButton#dockTool:pressed { background: #33255a; }
QToolButton#dockTool:disabled { color: #5c5c70; border-color: #24242f; background: #1a1a22; }

QDialogButtonBox QPushButton { min-width: 76px; }

/* ---- Lists & tables --------------------------------------------------------------------- */
QListWidget, QTableWidget, QTreeView, QPlainTextEdit { background: #121219; border: 1px solid #262632; border-radius: 9px; padding: 4px; }
QListWidget::item { padding: 7px 8px; border-radius: 6px; margin: 1px 0; }
QListWidget::item:hover:!selected { background: #1d1d28; }
QListWidget::item:selected { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #5b21b6, stop:1 #7c3aed); color: white; }
QListWidget#typeList::item { padding: 9px 10px; }
QTableWidget { gridline-color: transparent; }
QTableWidget::item { padding: 4px 6px; border-bottom: 1px solid #1d1d27; }
QTableWidget::item:selected { background: #2c2140; color: white; }
QHeaderView { background: transparent; }
QHeaderView::section { background: transparent; color: #7f7f96; border: none; border-bottom: 1px solid #262632; padding: 6px; font-weight: 600; }

/* ---- Inputs ----------------------------------------------------------------------------- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QKeySequenceEdit {
    background: #121219; border: 1px solid #2f2f3d; border-radius: 8px; padding: 5px 8px; color: #ececf4;
    selection-background-color: #7c3aed; min-height: 18px;
}
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover { border-color: #3d3d4f; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QPlainTextEdit:focus { border-color: #8b5cf6; }
QLineEdit:disabled, QSpinBox:disabled, QComboBox:disabled { color: #5c5c70; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView { background: #1b1b25; border: 1px solid #2f2f3d; border-radius: 8px; padding: 4px; selection-background-color: #5b21b6; }
QSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::up-button, QDoubleSpinBox::down-button { width: 16px; border: none; background: transparent; }

QCheckBox { spacing: 8px; }
QCheckBox::indicator, QTableWidget::indicator, QListWidget::indicator { width: 16px; height: 16px; border-radius: 5px; border: 1px solid #45455a; background: #121219; }
QCheckBox::indicator:hover, QTableWidget::indicator:hover, QListWidget::indicator:hover { border-color: #8b5cf6; }
QCheckBox::indicator:checked, QTableWidget::indicator:checked, QListWidget::indicator:checked { background: #7c3aed; border-color: #8b5cf6; image: url(:/check.svg); }

QGroupBox { border: 1px solid #2a2a37; border-radius: 10px; margin-top: 14px; padding: 14px 10px 10px 10px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 6px; color: #c4b5fd; }

/* ---- Meters & sliders ------------------------------------------------------------------- */
QProgressBar { background: #121219; border: none; border-radius: 4px; }
QProgressBar::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #22c55e, stop:0.75 #eab308, stop:1 #ef4444); border-radius: 4px; }

QSlider::groove:horizontal { height: 4px; background: #2f2f3d; border-radius: 2px; }
QSlider::sub-page:horizontal { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7c3aed, stop:1 #c084fc); border-radius: 2px; }
QSlider::handle:horizontal { background: #f5f3ff; width: 14px; margin: -6px 0; border-radius: 7px; border: 2px solid #7c3aed; }
QSlider::handle:horizontal:hover { background: #ffffff; border-color: #a78bfa; }

/* ---- Scrollbars: thin, out of the way ---------------------------------------------------- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #2f2f3d; border-radius: 3px; min-height: 28px; }
QScrollBar::handle:horizontal { background: #2f2f3d; border-radius: 3px; min-width: 28px; }
QScrollBar::handle:hover { background: #4b4b60; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QScrollArea { background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }

/* ---- Menus, status, tooltips ------------------------------------------------------------ */
QMenuBar { background: #15151d; color: #d8d8e6; padding: 2px 4px; }
QMenuBar::item { padding: 5px 10px; border-radius: 6px; background: transparent; }
QMenuBar::item:selected { background: #2c2140; }
QMenu { background: #1b1b25; border: 1px solid #2f2f3d; border-radius: 10px; padding: 6px; }
QMenu::item { padding: 7px 26px 7px 14px; border-radius: 6px; }
QMenu::item:selected { background: #5b21b6; color: white; }
QMenu::item:disabled { color: #5c5c70; }
QMenu::separator { height: 1px; background: #2f2f3d; margin: 5px 8px; }

QStatusBar { background: #15151d; color: #9a9ab0; border-top: 1px solid #23232e; }
QStatusBar::item { border: none; }
QToolTip { background: #1f1f2a; color: #ececf4; border: 1px solid #3d3d4f; border-radius: 6px; padding: 5px 8px; }

/* Stream Health dock */
QLabel#healthBanner { background: #1a1a24; border: 1px solid #272734; border-radius: 12px; padding: 12px 14px; font-size: 14px; }
QWidget#healthRow { background: #17171f; border: 1px solid #2a2a37; border-radius: 12px; }
QWidget#healthRow QLabel { background: transparent; border: none; }
